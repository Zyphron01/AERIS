# ==============================================================================
# AERIS — Environment Configuration Template
# Copy this file to .env.local and configure your credentials.
# Do NOT commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API (Required for AI Explanations & Assistant)
# Obtain a key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Persistence (Optional — Guest Mode works without it)
# Obtain from your Supabase project settings: https://supabase.com/dashboard
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# ------------------------------------------------------------------------------
# 3. Distributed Rate Limiting via Upstash Redis (Optional for production)
# If omitted, AERIS falls back to an in-memory sliding-window rate limiter.
# ------------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. Automated Integration Test Credentials (Optional for local live testing)
# Never use personal or production accounts.
# ------------------------------------------------------------------------------
# TEST_USER_1_EMAIL=test_user1@example.com
# TEST_USER_1_PASSWORD=PlaceholderPassword1!
# TEST_USER_2_EMAIL=test_user2@example.com
# TEST_USER_2_PASSWORD=PlaceholderPassword2!
